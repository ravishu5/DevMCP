# ---------------------------------------------------------------------------
# Implementation Intelligence MCP — configuration
#
# Every value below is OPTIONAL. With an empty environment the server still
# starts, in documented degraded modes (unauthenticated GitHub at 60 req/hr,
# no code index). Nothing here is required to boot.
#
# Never commit a real .env. Secrets are read from the environment only, and
# are never logged or returned in a tool result.
# ---------------------------------------------------------------------------

# --- GitHub ----------------------------------------------------------------
# A classic or fine-grained PAT with public_repo (read) scope.
# If unset, the server falls back to `gh auth token` (see GITHUB_USE_GH_CLI),
# and if that fails, to unauthenticated access.
#   authenticated:   5000 core req/hr, 30 search/min, 10 code-search/min
#   unauthenticated:   60 core req/hr — enough to demo, not to work
GITHUB_TOKEN=

# Use the `gh` CLI as a token fallback. Default: true.
GITHUB_USE_GH_CLI=true

# GitHub Enterprise: point at your instance's API root.
GITHUB_API_BASE=https://api.github.com
GITHUB_TIMEOUT_MS=20000

# --- jCodeMunch (deep code understanding) ----------------------------------
ENABLE_CODE_INDEX=true

# stdio transport (default). The server spawns this as a subprocess.
JCODEMUNCH_COMMAND=uvx
JCODEMUNCH_ARGS=jcodemunch-mcp serve

# HTTP transport instead — set this and the stdio settings are ignored.
# JCODEMUNCH_ENDPOINT=http://127.0.0.1:8901

# Indexing a large repository is slow. These caps keep one bad repository from
# hanging a tool call (spec §21 "huge repositories").
JCODEMUNCH_INDEX_TIMEOUT_MS=180000
JCODEMUNCH_CALL_TIMEOUT_MS=45000
JCODEMUNCH_MAX_REPO_SIZE_KB=250000

# --- Cache & knowledge base ------------------------------------------------
ENABLE_CACHE=true
CACHE_PATH=~/.implementation-mcp/cache.sqlite

# TTLs apply to MUTABLE entries only. Anything keyed by commit SHA is immutable
# and never expires — same commit, same source, same analysis.
CACHE_SEARCH_TTL_MS=21600000
CACHE_METADATA_TTL_MS=86400000
CACHE_MAX_ENTRIES=50000

# Feature fingerprints: remember which capabilities a repo evidences, so later
# searches can shortlist known repositories without spending GitHub quota.
ENABLE_FINGERPRINTS=true

# --- Discovery budget ------------------------------------------------------
# GitHub search is 30/min and code search 10/min. These caps exist to keep a
# single tool call from exhausting the shared quota.
MAX_REPOSITORIES=40
MAX_DEEP_ANALYSIS=5
MIN_REPOSITORY_SCORE=35
MAX_QUERIES_PER_FEATURE=6

# --- Context budget --------------------------------------------------------
# Ceilings, not targets. We optimise useful-information-per-token, not minimum
# tokens (spec §26): a bundle may come in well under these.
MAX_CONTEXT_TOKENS=6000
MAX_SOURCE_TOKENS=3000

# --- Ranking ---------------------------------------------------------------
ENABLE_LICENSE_CHECK=true

# Override any subset of ranking weights as JSON. Unspecified axes keep their
# default, and the full set is renormalised to sum to 1 so scores stay 0-100.
# Axes: featureRelevance completeness stackMatch implementationQuality
#       architectureMatch testEvidence maintenance documentation popularity
#       dependencySimplicity integrationSurface licenseCompatibility
# RANKING_WEIGHTS={"licenseCompatibility":0.20,"popularity":0.01}

# --- Observability ---------------------------------------------------------
# Attach the token-efficiency metrics block to every tool result.
ENABLE_DIAGNOSTICS=false

# Logs go to stderr only — stdout is the MCP protocol channel.
LOG_LEVEL=info
LOG_JSON=false
