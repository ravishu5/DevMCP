{
  "name": "implementation-intelligence-mcp",
  "version": "0.1.0",
  "description": "MCP server that discovers, evaluates and packages proven open-source implementations for AI coding agents.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=20" },
  "bin": {
    "implementation-mcp": "./dist/cli/index.js",
    "implementation-mcp-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "README.md", "ARCHITECTURE.md", "SECURITY.md", "LICENSE.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "cli": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "test:perf": "vitest run tests/perf",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.8.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
